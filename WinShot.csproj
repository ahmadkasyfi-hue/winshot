<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinShot.ico</ApplicationIcon>
    <AssemblyTitle>WinShot</AssemblyTitle>
    <Product>WinShot</Product>
    <Company>WinShot</Company>
    <Version>0.2.0</Version>

    <!-- Single-file publish friendly. Actual publishing is driven by the
         PublishProfiles\SingleFile.pubxml or `dotnet publish` flags. -->
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <!-- Proper WPF tray icon with XAML context menu. -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the icon inside the assembly so the tray and Window classes can
         access it via a pack:// URI without a file lookup. -->
    <Resource Include="Assets\WinShot.ico" />
  </ItemGroup>

</Project>
