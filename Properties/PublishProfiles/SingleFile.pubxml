<?xml version="1.0" encoding="utf-8"?>
<!--
  File: WinShot/Properties/PublishProfiles/SingleFile.pubxml

  Self-contained single-file publish profile for WinShot.

  Invoke with:
      dotnet publish WinShot/WinShot.csproj -c Release /p:PublishProfile=SingleFile

  Why self-contained: users installing via the Inno Setup installer should
  NOT be required to have the .NET 8 Desktop runtime pre-installed. Bundling
  the runtime pushes the single-file output to roughly 150 MB (native
  libraries are extracted on first run to %LOCALAPPDATA%\Microsoft\NET\...
  because WPF ships unmanaged assets that can't be linked in-process).

  If you prefer a smaller ~1 MB portable EXE and are willing to require the
  runtime, flip SelfContained to false.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows</TargetFramework>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!--
      Pack unmanaged native dependencies inside the single-file bundle.
      WPF has some that can't be statically linked, so they're unpacked to
      a temp folder at startup. IncludeNativeLibrariesForSelfExtract=true
      is the recommended setting for WPF self-contained single-file apps.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      ReadyToRun precompiles IL to native to reduce cold-start latency
      (the app is launched every time the user hits Ctrl+Shift+S, so
      startup responsiveness matters).
    -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!--
      Don't trim — WPF + reflection-heavy MVVM source generators produce
      false positives that are hard to diagnose on user machines.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Debug symbols live alongside the EXE for crash-dump analysis. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
