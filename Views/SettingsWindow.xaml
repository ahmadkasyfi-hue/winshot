<Window x:Class="WinShot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShot — Settings"
        Width="560" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1F22">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEF0F2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#2A2D31"/>
            <Setter Property="Foreground" Value="#EEF0F2"/>
            <Setter Property="BorderBrush" Value="#3A3D42"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2D31"/>
            <Setter Property="Foreground" Value="#EEF0F2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                   Foreground="#EEF0F2" Margin="0,0,0,14"/>

        <!-- Fields -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Save directory -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Save directory"/>
            <TextBox  Grid.Row="0" Grid.Column="1" x:Name="SaveDirBox"/>
            <Button   Grid.Row="0" Grid.Column="2" Content="Browse…" Click="OnBrowse"/>

            <!-- Filename template -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Filename template"/>
            <TextBox  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FileNameBox"/>

            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                       FontSize="11" Foreground="#A0A4AA"
                       Text="Use {timestamp:FORMAT} where FORMAT is a .NET date format (e.g. yyyyMMdd_HHmmss)."
                       TextWrapping="Wrap"/>

            <!-- Default format -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Default format"/>
            <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="FormatBox" SelectedIndex="0" HorizontalAlignment="Left" MinWidth="120">
                <ComboBoxItem Content="PNG" Tag="png"/>
                <ComboBoxItem Content="JPEG" Tag="jpg"/>
            </ComboBox>

            <!-- JPEG quality -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="JPEG quality"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                <Slider x:Name="QualitySlider" Minimum="40" Maximum="100" Value="92"
                        Width="200" VerticalAlignment="Center"
                        TickFrequency="5" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="QualityText" Text="92" MinWidth="32" TextAlignment="Right" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Reveal checkbox -->
            <CheckBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                      x:Name="RevealCheck"
                      Foreground="#EEF0F2"
                      Content="Open File Explorer to the saved file after Save"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"  Click="OnCancel"/>
            <Button Content="Save"    Click="OnSave" IsDefault="True" Background="#4F8EF7" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
