<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="http://www.hardcodet.net/taskbar">

    <!--
        TaskbarIcon sits in the application's merged resources so it lives
        for the entire app lifetime. App.xaml.cs retrieves it via
        Application.Current.FindResource("WinShotTray") and wires Click
        handlers by looking up menu items by their Tag — this avoids having
        to juggle x:Name across the ResourceDictionary name scope.
    -->
    <tb:TaskbarIcon x:Key="WinShotTray"
                    IconSource="pack://application:,,,/Assets/WinShot.ico"
                    ToolTipText="WinShot — Ctrl+Shift+S to capture">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Capture region   (Ctrl+Shift+S)" Tag="capture"/>
                <Separator/>
                <MenuItem Header="Settings…"                       Tag="settings"/>
                <MenuItem Header="About WinShot"                   Tag="about"/>
                <Separator/>
                <MenuItem Header="Exit WinShot"                    Tag="exit"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
</ResourceDictionary>
