<Window x:Class="WinShot.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShot — Editor"
        Icon="pack://application:,,,/Assets/WinShot.ico"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        MinWidth="620" MinHeight="360"
        Background="#1E1F22"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Tool toggle button -->
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3A3D42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action button (Copy / Save / Save & Copy / Settings / Exit) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ToolbarForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3A3D42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#202224"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (accented) action for the preferred default -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F8EF7"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ============ TOOLBAR ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBackground}" Padding="8,6">
            <StackPanel Orientation="Horizontal">

                <!-- Tools with single-letter accelerators shown in labels. -->
                <ToggleButton x:Name="ToolSelect"      Style="{StaticResource ToolButton}" Click="OnToolClicked" Tag="Select"       ToolTip="Select / move / resize existing shapes (S). Delete removes the selected shape.">
                    <TextBlock><Run Text="Select "/><Run Foreground="#A0A4AA" Text="(S)"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ToolArrow"       Style="{StaticResource ToolButton}" Click="OnToolClicked" Tag="Arrow"        ToolTip="Arrow tool (A)">
                    <TextBlock><Run Text="Arrow "/><Run Foreground="#A0A4AA" Text="(A)"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ToolRect"        Style="{StaticResource ToolButton}" Click="OnToolClicked" Tag="Rectangle"    ToolTip="Rectangle tool (R)">
                    <TextBlock><Run Text="Rect "/><Run Foreground="#A0A4AA" Text="(R)"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ToolEllipse"     Style="{StaticResource ToolButton}" Click="OnToolClicked" Tag="Ellipse"      ToolTip="Ellipse tool (E)">
                    <TextBlock><Run Text="Ellipse "/><Run Foreground="#A0A4AA" Text="(E)"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ToolLine"        Style="{StaticResource ToolButton}" Click="OnToolClicked" Tag="Line"         ToolTip="Line tool (L)">
                    <TextBlock><Run Text="Line "/><Run Foreground="#A0A4AA" Text="(L)"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ToolText"        Style="{StaticResource ToolButton}" Click="OnToolClicked" Tag="Text"         ToolTip="Text tool (T)">
                    <TextBlock><Run Text="Text "/><Run Foreground="#A0A4AA" Text="(T)"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ToolHighlighter" Style="{StaticResource ToolButton}" Click="OnToolClicked" Tag="Highlighter"  ToolTip="Highlighter (H)">
                    <TextBlock><Run Text="Highlight "/><Run Foreground="#A0A4AA" Text="(H)"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ToolBlur"        Style="{StaticResource ToolButton}" Click="OnToolClicked" Tag="Blur"         ToolTip="Blur / pixelate (B)">
                    <TextBlock><Run Text="Blur "/><Run Foreground="#A0A4AA" Text="(B)"/></TextBlock>
                </ToggleButton>

                <Border Width="1" Background="#4A4D52" Margin="10,2"/>

                <!-- Color swatches (populated in code-behind) -->
                <TextBlock Text="Color" Foreground="{StaticResource ToolbarForeground}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ItemsControl x:Name="ColorStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Width="1" Background="#4A4D52" Margin="10,2"/>

                <!-- Thickness -->
                <TextBlock Text="Size" Foreground="{StaticResource ToolbarForeground}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <Slider x:Name="ThicknessSlider" Width="100" Minimum="1" Maximum="24" Value="3"
                        VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="OnThicknessChanged"/>
                <TextBlock x:Name="ThicknessText" Text="3" Width="20" Foreground="{StaticResource ToolbarForeground}"
                           VerticalAlignment="Center" TextAlignment="Center"/>

                <Border Width="1" Background="#4A4D52" Margin="10,2"/>

                <!-- Edit actions -->
                <Button Style="{StaticResource ActionButton}" Content="Undo  (Ctrl+Z)" Click="OnUndo"/>
                <Button Style="{StaticResource ActionButton}" Content="Clear"          Click="OnClear"/>
            </StackPanel>
        </Border>

        <!-- ============ BOTTOM ACTION BAR ============ -->
        <Border DockPanel.Dock="Bottom" Background="#24262A" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock x:Name="SaveDirHint"
                               Foreground="#A0A4AA" FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="520"
                               ToolTip="{Binding ElementName=SaveDirHint, Path=Text}"/>
                    <Button Style="{StaticResource ActionButton}"
                            Content="Settings…"
                            Margin="10,0,0,0"
                            Click="OnOpenSettings"
                            ToolTip="Change the save directory, filename, format, etc."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <Button Style="{StaticResource ActionButton}"
                            Content="Save As…"
                            Click="OnSaveAs"
                            ToolTip="Pick a specific file location for this screenshot."/>
                    <Border Width="1" Background="#4A4D52" Margin="8,2"/>
                    <Button Style="{StaticResource ActionButton}"
                            Content="Copy  (Ctrl+C)"
                            Click="OnActionCopy"/>
                    <Button Style="{StaticResource ActionButton}"
                            Content="Save  (Ctrl+S)"
                            Click="OnActionSave"
                            ToolTip="Saves to the configured folder with the configured filename template."/>
                    <Button Style="{StaticResource PrimaryActionButton}"
                            Content="Save &amp; Copy  (Ctrl+Enter)"
                            Click="OnActionSaveAndCopy"/>
                    <Border Width="1" Background="#4A4D52" Margin="8,2"/>
                    <Button Style="{StaticResource ActionButton}"
                            Content="Exit WinShot"
                            Foreground="#F08080"
                            Click="OnExitApp"
                            ToolTip="Closes the tray app entirely — the hotkey will stop working."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ CANVAS ============ -->
        <Grid Background="#0F1012" MinWidth="320" MinHeight="240">
            <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="Screenshot" Stretch="None" SnapsToDevicePixels="True"/>
                <ContentControl x:Name="InkHost" IsHitTestVisible="False"/>
                <Canvas x:Name="InteractionCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="OnCanvasMouseDown"
                        MouseMove="OnCanvasMouseMove"
                        MouseLeftButtonUp="OnCanvasMouseUp">
                    <TextBox x:Name="InlineTextBox"
                             Visibility="Collapsed"
                             MinWidth="80"
                             Background="#CC000000"
                             Foreground="White"
                             CaretBrush="White"
                             BorderBrush="#4F8EF7"
                             BorderThickness="1"
                             Padding="3,1"
                             FontSize="20"
                             AcceptsReturn="False"
                             KeyDown="OnInlineTextBoxKeyDown"
                             LostFocus="OnInlineTextBoxLostFocus"/>
                </Canvas>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
