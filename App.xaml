<Application x:Class="WinShot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        ShutdownMode=OnExplicitShutdown because the app has no persistent main
        window — it lives in the tray waiting on the global hotkey. We call
        Application.Current.Shutdown() from the tray "Exit" item.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/TrayIconHost.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ToolbarBackground" Color="#2A2D31"/>
            <SolidColorBrush x:Key="ToolbarForeground" Color="#EEF0F2"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#4F8EF7"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
